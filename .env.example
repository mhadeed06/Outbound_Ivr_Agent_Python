
# =========================
# Public URLs (required)
# =========================
# Your public https base (e.g., ngrok, Cloudflare Tunnel, or prod domain)
# Example: https://abcd-12-34-56-78.ngrok-free.app
WEBHOOK_BASE_URL=https://REPLACE_WITH_PUBLIC_BASE

# =========================
# Telnyx (required)
# =========================
TELNYX_API_KEY=REPLACE_ME
TEL_FROM=+1800.....    # Your Telnyx number in E.164
TEL_TO=+1855.....      # The destination number in E.164   
CALL_CONTROL_APP_ID=REPLACE_ME              # Your Telnyx Call Control App ID

# =========================
# Azure Speech (required)
# =========================
AZURE_SPEECH_KEY=REPLACE_ME
AZURE_SPEECH_REGION=centralus               # e.g., eastus, centralus, westeurope
AZURE_SPEECH_ENDPOINT=https-Replace_me

# =========================
# LLMs
# =========================
# Local Llama endpoint used by services/llm_service.py
LLM_URL=http://1-REPLACE_ME:8080

# OpenAI (used by the claims controller keyword-decider)
OPENAI_API_KEY=sk-REPLACE_ME

# =========================
# Insurance Behavior Switch
# =========================
# Options: CIGNA | HUMANA | BAYLOR_SCOTT
INSURANCE_TYPE=CIGNA

# =========================
# JWT Authentication
# =========================
JWT_SECRET_KEY=REPLACE_ME
